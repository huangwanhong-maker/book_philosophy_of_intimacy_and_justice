# ── Documents & reports ──────────────────────────────────────────────────────
documents:
  - { type: publication, label: "I — Toward Relational Being in Intimate Life", subtitle: "A Family-and-Relationship Management Application as a Case Study", summary: "How should the measurement-driven software that increasingly mediates intimate life be governed if its aim is a relationship's flourishing? It builds an integrative-justice framework on a relational ontology, licenses measurement site by site (an 'ethics of dialectical-positivist practice'), instantiates it in a working application, and names wrongs specific to intimate computing — chief among them proxy epistemic injustice.", keywords: [relational being, intimate computing, integrative justice, generative presence, data ethics],                  path: papers/paper-1-relational-being-intimate-life_SSRN_260604.pdf, format: pdf, date: 2026-06-04, visibility: public }
  - { type: publication, label: "II — The Justice and Ethics of AI-Mediated Intimacy", subtitle: "Alienation, Power, Exploitation, and the Limits of Instrumental Imputation", summary: "If an AI-suggested tender gesture genuinely improves a relationship and deceives no one, is anything still wrong? Proceeding dialectically through Hegel, Marx, modern agency law, and Buddhism, it distinguishes an act's allocative face (budgetable attention) from its constitutive face (who attends), names AI's danger 'distributive reduction', and separates two wrongs with two remedies: misattribution, curable by transparency, and process alienation, not curable by consent.", keywords: [AI-mediated communication, alienation, imputation, strictly personal acts, intimacy, epistemic injustice],           path: papers/paper-2-AI-mediated-intimacy.pdf,                       format: pdf, visibility: public }
  - { type: publication, label: "III — The Normativity of Self-Legislation in Intimate Relationships", subtitle: "On a Lover's Vow, the Rights-Order It Institutes, and the Conditions under Which It Becomes Domination", summary: "A lover vows to keep loving 'whatever happens'. Analysed across freedom (reasons-responsiveness), morality (constancy versus responsiveness), and justice (republican non-domination and a Hohfeldian rights analysis), a unilaterally legislated law over a two-person life proves unjust unless each party keeps the standing to contest its terms — an isomorphism linking the micro-order of a vow to the macro-order of political economy.", keywords: [self-legislation, autonomy, non-domination, recognition, Hohfeldian rights, relational autonomy], path: papers/paper-3.pdf,                                     format: pdf, visibility: public }
  - { type: publication, label: "IV — The Language of the Gift in Intimate Relationships", subtitle: "On the Gift as Love's Language, the Ledger It Is Read Into, and the Conditions under Which the Reading Becomes Alienation", summary: "The gift is love's native language, but economics makes it tractable by reading it into a ledger. Drawing on semiotics (gift as positional sign-value), Lacan (it signifies desire, not need), and formal-language theory, it characterises alienation precisely as the contraction of generative practice onto what the ledger can see, and proposes recirculation depth — not bilateral balance — as the right measure of justice.", keywords: [gift, semiotics, sign-value, desire, formal language theory, alienation, generative justice],        path: papers/paper-4.pdf,                                           format: pdf, visibility: public }
  - { type: publication, label: "V — The Formation of the Subject in Intimate Relationships",      path: papers/paper5-subject-formation.pdf,                          format: pdf, visibility: public }
  - { type: publication, label: "VI — Toward a Just Proposal",                                     path: papers/paper-6.pdf,                                           format: pdf, visibility: public }
  - { type: publication, label: "VII — Prolegomena to a Diplomacy of Intimate Relationships",      path: papers/paper-7.pdf,                                           format: pdf, visibility: public }
  - { type: publication, label: "VIII — The Intervention of Language in Intimacy (Excursus)",      path: papers/paper-8.pdf,                                           format: pdf, visibility: public }
  - { type: publication, label: "IX — The Sustainability of Intimacy (working draft)",             path: papers/paper-9.pdf,                                           format: pdf, visibility: public }
  - { type: publication, label: "X — The Joint Attention of Value and the Creation of Language (working draft)", path: papers/paper-10.pdf,                              format: pdf, visibility: public }
  - { type: publication, label: "XI — A Just Eudaimonia (working draft)",                          path: papers/paper-11.pdf,                                          format: pdf, visibility: public }
  - { type: publication, label: "XII — The Sweet Cycle (working draft)",                           path: papers/paper-12.pdf,                                          format: pdf, visibility: public }
  - { type: publication, label: "XIII — The Causality of the Non-Binding Vow (working draft)",      path: papers/paper-13.pdf,                                          format: pdf, visibility: public }
  - { type: publication, label: "XIV — Contingency, Existence, and Eudaimonia in Intimate Relations", path: papers/paper-14.pdf,                                        format: pdf, visibility: public }
  - { type: publication, label: "XV — The Political Economy of Intimate Relations",                  path: papers/paper-15.pdf,                                        format: pdf, visibility: public }

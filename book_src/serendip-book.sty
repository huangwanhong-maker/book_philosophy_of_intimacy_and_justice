\RequirePackage{pagecolor}
\pagecolor{pageblush}

% ── Headings: chapter = paper, section = the paper's own top level ───────────
\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\filright}
  {\Large\scshape\color{rosedeep}\chaptertitlename\ \thechapter}
  {0.6em}
  {\Huge\bfseries\color{warnred}}
\titlespacing*{\chapter}{0pt}{10pt}{28pt}
\titleformat{\section}{\Large\mdseries\color{rosedeep}}{\thesection.}{0.6em}{}
\titleformat{\subsection}{\large\mdseries\color{rose}}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalsize\itshape\color{gold}}{\thesubsubsection}{0.5em}{}

% ── Running heads ────────────────────────────────────────────────────────────
\RequirePackage{fancyhdr}
\setlength{\headheight}{14pt}
\pagestyle{fancy}
\fancyhf{}
% \nouppercase: the book class's \chaptermark/\sectionmark wrap the title in
% \MakeUppercase, which would uppercase colour names inside an \emph-in-title
% (\color{pinkitalic} -> \color{PINKITALIC}, an undefined colour). Marks are
% also set without \MakeUppercase, and titles are stripped of \emph colouring
% for the head. Small caps carry the styling instead.
\renewcommand{\chaptermark}[1]{\markboth{#1}{#1}}
\renewcommand{\sectionmark}[1]{\markright{#1}}
\fancyhead[LE]{\footnotesize\scshape\color{rose}\nouppercase{\leftmark}}
\fancyhead[RO]{\footnotesize\scshape\color{rose}\nouppercase{\rightmark}}
\fancyfoot[C]{\footnotesize\color{ink}\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\color{ink}\thepage}%
  \renewcommand{\headrulewidth}{0pt}}
% \lrhead is defined by paper XXI; it comes in via serendip-macros.sty.

% A paper's own \appendix must NOT switch the whole book into appendix mode
% (book-class \appendix resets the chapter counter, which re-letters every later
% chapter: 1, A, B, ...). Redefine it to affect only SECTION numbering, so a
% paper's appendix sections become A, B, C within their chapter, and the chapter
% number is untouched. \paperchapter resets section numbering at each chapter
% start so the change never leaks to the next paper.
\renewcommand\appendix{\par
  \setcounter{section}{0}%
  \gdef\thesection{\@Alph\c@section}}

% ── Emphasis recolouring (series signature) ─────────────────────────────────
\let\oldtextit\textit
\renewcommand{\textit}[1]{{\color{pinkitalic}\oldtextit{#1}}}
\let\oldemph\emph
\renewcommand{\emph}[1]{{\color{pinkitalic}\oldemph{#1}}}
\let\oldtextbf\textbf
\renewcommand{\textbf}[1]{{\color{pinkbold}\oldtextbf{#1}}}


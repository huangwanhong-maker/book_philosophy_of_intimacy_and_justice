% =========================================================================
%  Paper macros are NOT hand-written here. They are harvested VERBATIM from
%  the 27 papers into serendip-macros.sty (loaded at the foot of this file).
%  Writing them from memory silently changes their meaning — \pinkref, for
%  instance, is a colour wrapper around arbitrary text, not a \ref.
% =========================================================================

% \todo — 11 unresolved author notes remain in the manuscript (VII×8, XX, XXI,
% XXIV). They must not reach the finished book. During revision they render as
% a loud inline marker and raise a warning, so the volume still builds and the
% notes stay visible; `make todo-check` is the gate that must return zero
% before a volume is called book-ready. See docs/REVISION_TRACKER.md.
\newcommand{\todo}[1]{%
  \PackageWarning{serendip-book}{UNRESOLVED \string\todo: #1}%
  {\normalfont\bfseries\color{warnred}[TODO: #1]}}
\let\TODO\todo

% ── The `abstract` environment does NOT exist in the book class. ─────────────
% Each paper opens with one; in the book it becomes a set-off headnote under
% the chapter title.
\newenvironment{abstract}
  {\begingroup\small\itshape\color{ink}\setlength{\leftskip}{1.2em}\setlength{\rightskip}{1.2em}%
   \noindent\ignorespaces}
  {\par\endgroup\vspace{1.2em}\goldrule}

% Table default
\renewcommand{\arraystretch}{1.25}


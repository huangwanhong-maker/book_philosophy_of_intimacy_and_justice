% =========================================================================
%  serendip-book.sty — style for the three-volume book edition of
%  "Philosophy of Intimacy and the Theory of Justice".
%
%  Companion to serendip-paper.sty (which stays the style for the STANDALONE
%  papers, still published individually on SSRN/OSF). This file is its book
%  counterpart: same palette and voice, but for \documentclass{book} —
%  chapters, running heads, two-sided margins, continuous pagination.
%
%  It is the UNION of every package, colour, font, macro and environment the
%  27 papers define in their own preambles, so that a paper's body compiles
%  unchanged as a chapter. Where papers disagreed, the conflict is resolved
%  here, once (see "Resolved conflicts" below).
%
%  Bibliography: biblatex + biber, authoryear — unified across all 27 papers.
%  (natbib cannot coexist with biblatex, and a volume spans both camps.)
%
%  Compile with XeLaTeX.
% =========================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{serendip-book}[2026/07/12 Philosophy of Intimacy — book edition style]

% xcolor is pulled in by tikz/tcolorbox below, so the [table] option (which
% gives \rowcolor, used by VII and XI) must be registered before they load.
\PassOptionsToPackage{table}{xcolor}

% ── Fonts & language ─────────────────────────────────────────────────────────
\RequirePackage{fontspec}
\RequirePackage[english]{babel}
\newfontfamily\cjkfont{Noto Serif CJK SC}
\newfontfamily\greekfont{DejaVu Serif}
% Resolved: papers used \cjk and \cjkfont interchangeably; \grk and \greekfont
% likewise. Alias them so every paper's body works untouched.
\let\cjk\cjkfont
\let\grk\greekfont

% ── Page: two-sided book, B5 trim with a binding margin ──────────────────────
% B5 (176x250mm) is the academic-monograph standard (Japan/ISO); its larger text
% block keeps a 1000+ page work bindable. The designed covers are rendered to
% match (assets/cover_front_vol*.pdf, cover_back_book.pdf).
\RequirePackage[b5paper,inner=24mm,outer=18mm,top=24mm,bottom=26mm,twoside]{geometry}
\RequirePackage{setspace}
\onehalfspacing
\RequirePackage{parskip}
\RequirePackage[protrusion=true,expansion=false]{microtype}
\RequirePackage{emptypage}

% ── Packages the papers need (union across all 27) ───────────────────────────
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{tabularx}
\RequirePackage{makecell}
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{ragged2e}
\RequirePackage{csquotes}
\RequirePackage{epigraph}
\RequirePackage{pdflscape}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,shapes.geometric,
                decorations.pathmorphing,fit,backgrounds}
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins,breakable}

% TikZ styles from paper XXII's preamble.tex (its figures use chainbox/stepnode/
% facenode/chainarrow/maplink). Harvested here because only XXII's body — not
% its preamble — is included in the book.
\tikzset{
  chainbox/.style={draw=deeprose, fill=casebg, rounded corners=2pt,
    line width=0.6pt, text width=2.6cm, align=center, inner sep=5pt,
    font=\footnotesize\color{ink}},
  chainarrow/.style={-{Stealth[length=2.2mm]}, draw=goldenrod, line width=0.9pt},
  stepnode/.style={draw=rose, fill=blush, rounded corners=3pt, line width=0.6pt,
    text width=2.4cm, align=center, inner sep=5pt, font=\footnotesize\color{ink}},
  facenode/.style={draw=deeprose, fill=casebg, rounded corners=3pt, line width=0.6pt,
    text width=2.4cm, align=center, inner sep=5pt, font=\footnotesize\color{ink}},
  maplink/.style={-{Stealth[length=1.8mm]}, draw=rose, line width=0.7pt},
}
\RequirePackage{enumitem}
\setlist{itemsep=2pt, topsep=4pt}

% ── Table column types (union across the series) ─────────────────────────────
% RESOLVED CONFLICT: Y is p{3.1cm} in 16 papers but a tabularx X-column in XXI
% alone. In one document only one may win, so Y keeps the majority meaning and
% XXI's stretch column is Z. (XXI's tables were updated to match.)
\newcolumntype{Y}{>{\RaggedRight\arraybackslash}p{3.1cm}}
\newcolumntype{Z}{>{\RaggedRight\arraybackslash}X}
\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash}p{#1}}

